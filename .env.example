# Intelligent Resume Analyzer - Environment Configuration Example
# Copy to .env and configure as needed. NEVER commit .env to version control.

# Google Gemini API key (required only if ai.provider: gemini)
GEMINI_API_KEY=

# OpenAI or OpenAI-compatible API key (required only if ai.provider: openai_compatible)
OPENAI_API_KEY=

# Ollama Host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional path override for config.yaml
RESUME_ANALYZER_CONFIG=

# Optional directory override for app.data_dir
RESUME_ANALYZER_DATA_DIR=

# Optional logging level override (DEBUG, INFO, WARNING, ERROR, CRITICAL)
RESUME_ANALYZER_LOG_LEVEL=

